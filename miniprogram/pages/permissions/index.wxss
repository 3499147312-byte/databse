.permission-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 72rpx;
  border-bottom: 1rpx solid #e5ece9;
  font-size: 25rpx;
}

.permission-scope {
  flex: 0 0 auto;
}

.role-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding: 36rpx;
  background: rgba(0, 0, 0, 0.48);
}

.role-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 90vh;
  overflow: hidden;
  background: #fff;
  border-radius: 18rpx;
}

.role-scroll {
  flex: 1;
  min-height: 0;
  padding: 30rpx;
  overflow-y: auto;
}

.role-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #dfe7e4;
}
