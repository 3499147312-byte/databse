.editor-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.45);
}

.editor-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 88vh;
  overflow: hidden;
  background: #fff;
  border-radius: 18rpx;
}

.editor-scroll {
  flex: 1;
  min-height: 0;
  padding: 30rpx;
  overflow-y: auto;
}

.editor-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #dfe7e4;
  background: #fff;
}
